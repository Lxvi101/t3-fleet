{
  "name": "t3-fleet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only, fleet-wide live monitor for t3code servers. Runs beside t3code; never modifies it.",
  "scripts": {
    "start": "bun src/server.ts",
    "dev": "bun --watch src/server.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "setup:local": "bun scripts/setup-local.ts",
    "add-server": "bun scripts/add-server.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  },
  "license": "MIT",
  "repository": "github:Lxvi101/t3-fleet"
}
